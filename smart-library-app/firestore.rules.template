rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdministrator() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email == '__ADMIN_EMAIL__';
    }

    function hasValidMemberFields(data) {
      return data.keys().hasAll(['name', 'email', 'phone', 'timestamp'])
        && data.keys().hasOnly(['name', 'email', 'phone', 'timestamp'])
        && data.name is string
        && data.name.size() >= 3
        && data.name.size() <= 100
        && data.email is string
        && data.email.matches('^[^@ ]+@[^@ ]+\\.[^@ ]+$')
        && data.phone is string
        && data.phone.matches('^[0-9]{10}$')
        && data.timestamp is timestamp;
    }

    match /users/{userId} {
      allow create: if hasValidMemberFields(request.resource.data)
        && request.resource.data.timestamp == request.time;
      allow get, list: if isAdministrator();
      allow update: if isAdministrator()
        && hasValidMemberFields(request.resource.data)
        && request.resource.data.timestamp == resource.data.timestamp;
      allow delete: if isAdministrator();
    }
  }
}
